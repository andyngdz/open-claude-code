{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Claude Code",
  "mainBinaryName": "open-claude-code",
  "version": "0.1.7",
  "identifier": "dev.andyng.openclaudecode",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Claude Code",
        "width": 960,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["./windows/path.wxs"],
        "componentRefs": ["AddOpenClaudeCodeToPath"]
      }
    }
  }
}
